{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "TokenLimit": 100,
    "TokensPerPeriod": 50,
    "ReplenishmentPeriod": "00:00:01"
  },
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/v1/identity/{**rest}" }
      },
      "network": {
        "ClusterId": "network",
        "Match": { "Path": "/api/v1/network/{**rest}" }
      },
      "core-wallet": {
        "ClusterId": "core",
        "Match": { "Path": "/api/v1/wallet/{**rest}" }
      },
      "core-payments": {
        "ClusterId": "core",
        "Match": { "Path": "/api/v1/payments/{**rest}" }
      },
      "core-tickets": {
        "ClusterId": "core",
        "Match": { "Path": "/api/v1/tickets/{**rest}" }
      },
      "core-gate": {
        "ClusterId": "core",
        "Match": { "Path": "/api/v1/gate/{**rest}" }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": { "primary": { "Address": "http://localhost:5101/" } }
      },
      "network": {
        "Destinations": { "primary": { "Address": "http://localhost:5102/" } }
      },
      "core": {
        "Destinations": { "primary": { "Address": "http://localhost:5103/" } }
      }
    }
  }
}
